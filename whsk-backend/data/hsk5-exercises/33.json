    "20": {
      "number": 20,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "靠近交通主干道容易出事故"
        },
        {
          "id": "B",
          "text": "孤独症与交通污染可能有关"
        },
        {
          "id": "C",
          "text": "住房离交通主干道越远越好"
        },
        {
          "id": "D",
          "text": "儿童易受到噪音、尾气的伤害"
        }
      ],
      "sourcePage": 115,
      "passage": "科研人员对300多名孤独症患几及约260名没有患孤独症的儿童进行了一项调查，结果发现，环境因素或许是孤独症的一个致病原因，那些居住地离交通主十道大约300米的儿童患孤独症的风险较大。而离交通主干道近意味着受到噪音、尾气污染的风险较大，因此研究人员认为，交通污染可能会导致孤独症。"
    },
    "21": {
      "number": 21,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "语言交流是有技巧的"
        },
