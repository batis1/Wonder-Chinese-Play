    "19": {
      "number": 19,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "我和妻子准备回老家"
        },
        {
          "id": "B",
          "text": "父亲要求我把钥匙留给他"
        },
        {
          "id": "C",
          "text": "我们去外地时留父母在新房看家"
        },
        {
          "id": "D",
          "text": "父母打算每天来给我们打扫卫生"
        }
      ],
      "sourcePage": 19,
      "passage": "一段时间后，我和妻子又准备去外地打工，新房只能上锁空着。临走那天，父亲从老家赶来送我们。父亲悄悄把我拉到一边说：“你妈说了，你还是留一串新房的钥匙给我们，要是我和你妈什么时候想来了，就来住上几天，顺便给你们晒晒被子，打扫打扫卫生。”"
    },
    "20": {
