    "19": {
      "number": 19,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "压力和状态成正比"
        },
        {
          "id": "B",
          "text": "给人的压力应适度"
        },
        {
          "id": "C",
          "text": "运动员要特别紧张才有好成绩"
        },
        {
          "id": "D",
          "text": "潜力只有在压力大时才能发挥出来"
        }
      ],
      "sourcePage": 93,
      "passage": "很多研究发现，适度的压力有利于我们保持良好的状态，更加有助于挖掘我们的潜力，从而提高个人的工作效率。比如运动员每到参加比赛，尤其是决赛时，一定要将自己调整到接近最佳状态，感到适度的压力，让自己兴奋，如果他不紧张、没压力感，则不利于出成绩。适度的压力对挖掘自身的潜力，是有正面意义的。"
    },
    "20": {
      "number": 20,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "这个妇女为母亲买了一个轮椅"
