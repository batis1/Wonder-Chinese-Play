    "20": {
      "number": 20,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "刘宝全是著名的京剧演员"
        },
        {
          "id": "B",
          "text": "木板大鼓的伴奏乐器为三弦"
        },
        {
          "id": "C",
          "text": "京韵大鼓是木板大鼓的另一名称"
        },
        {
          "id": "D",
          "text": "京韵大鼓是在京剧的基础上发展出来的"
        }
      ],
      "sourcePage": 71,
      "passage": "“京韵大鼓”形成于北京和天津一带。20世纪初期著名鼓书艺人刘宝全等人在河北“木板大鼓”的基础上，吸收京剧唱腔和北京地方民间小调，同时使用北京语音进行演唱，并在原有伴奏乐器三弦外，增加了四胡和琵琶，创造出“京韵大鼓”这门曲艺艺术。"
    },
    "21": {
      "number": 21,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "郎中是对医生的一种尊称"
        },
        {
          "id": "B",
          "text": "郎中最早是一个国家机构"
        },
        {
          "id": "C",
          "text": "只有南方人才知道郎中的意思"
        },
        {
          "id": "D",
          "text": "战国时人们开始称医生为郎中"
        }
      ],
      "sourcePage": 71,
      "passage": "南方人尊称医生为郎中。为什么会有“郎中”这样的称呼呢？原来，郎中本来是一种官名，他的职责就是保护、陪同帝王，并随时提出建议。自战国时期就有此官，以后各朝各代都把侍郎、郎中作为各部门的重要职务。唐代以后因国家设立的官职太多太滥了，社会上就有了把医生叫作郎中的风俗。"
    },
    "22": {
      "number": 22,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
