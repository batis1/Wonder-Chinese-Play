    "26": {
      "number": 26,
      "type": "choice",
      "instruction": "阅读短文，选择正确答案。",
      "prompt": "作者认为，中国的饮食文化更追求什么？",
      "options": [
        {
          "id": "A",
          "text": "营养"
        },
        {
          "id": "B",
          "text": "形状"
        },
