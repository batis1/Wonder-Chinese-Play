    "26": {
      "number": 26,
      "type": "choice",
      "instruction": "阅读短文，选择正确答案。",
      "prompt": "作者觉得应聘像什么？",
      "options": [
        {
          "id": "A",
          "text": "考试"
        },
        {
          "id": "B",
          "text": "谈判"
        },
