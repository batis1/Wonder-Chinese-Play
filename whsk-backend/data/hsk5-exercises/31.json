    "26": {
      "number": 26,
      "type": "choice",
      "instruction": "阅读短文，选择正确答案。",
      "prompt": "小狗见到警察为什么流泪？",
      "options": [
        {
          "id": "A",
          "text": "不愿意回家"
        },
        {
          "id": "B",
