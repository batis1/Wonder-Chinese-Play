    "19": {
      "number": 19,
      "type": "choice",
      "instruction": "选择与短文内容一致的一项。",
      "prompt": "",
      "options": [
        {
          "id": "A",
          "text": "人每天要吃东西，所以难免会得病"
        },
        {
          "id": "B",
          "text": "要想不得病，就要注意食物的卫生"
